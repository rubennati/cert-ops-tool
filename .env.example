# =============================================
# cert-ops-tool – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Certificate issuing + renewal tool using acme.sh
# with Cloudflare DNS-01 challenge. For devices that
# don't sit behind a reverse proxy (NAS, routers,
# mail servers, etc.).
#
# Supports ACME servers: Let's Encrypt, ZeroSSL, Buypass.
# =============================================

COMPOSE_PROJECT_NAME=cert-ops-tool

# --- Images ---
# cert-ops-tool (https://github.com/rubennati/cert-ops-tool/pkgs/container/cert-ops-tool)
APP_TAG=v0.2.0

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}

# --- ACME Configuration ---
ACME_EMAIL=admin@example.com
# ACME server: letsencrypt | zerossl | buypass
ACME_SERVER=letsencrypt
# Key type: ec-256 | ec-384 | 2048 | 3072 | 4096
CERT_KEYLENGTH=ec-256

# --- Default Certificate ---
# Used by wizard.sh as defaults. Override per invocation.
CERT_DOMAIN=example.com
CERT_SAN=*.example.com

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Create the secrets directory and file:
#   mkdir -p .secrets
#   printf '%s' 'your-cloudflare-api-token' > .secrets/cf_token.txt
#
# Token requirements:
#   - Zone > DNS > Edit on the target zone
#   - Use a scoped API Token, NOT the Global API Key
#
# DNS providers other than Cloudflare:
#   acme.sh supports 100+ DNS providers. To use a different one,
#   set the provider-specific env vars in this .env and adapt
#   scripts/issue.sh (change --dns dns_cf to your provider).
#   See: https://github.com/acmesh-official/acme.sh/wiki/dnsapi
